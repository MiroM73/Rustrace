# --- Error codes ---
# Key = "code." + HRESULT in hex (8 digits, upper case). Win32/MSI codes use 0x8007xxxx.
# You can add your own codes here (or in your own language file).
code.success = Success (S_OK / ERROR_SUCCESS).
code.unknown = Unknown code ({facility})
code.source.description = Description
code.source.windows = Windows
code.0x80004001 = E_NOTIMPL – not implemented.
code.0x80004002 = E_NOINTERFACE – no such interface supported.
code.0x80004004 = E_ABORT – operation aborted.
code.0x80004005 = E_FAIL – unspecified error.
code.0x8000FFFF = E_UNEXPECTED – unexpected failure.
code.0x80041001 = WBEM_E_FAILED – generic WMI failure.
code.0x80041002 = WBEM_E_NOT_FOUND – WMI object not found.
code.0x80041010 = WBEM_E_INVALID_CLASS – invalid WMI class (often a corrupted WMI repository or missing client class).
code.0x80070002 = ERROR_FILE_NOT_FOUND – the system cannot find the file specified.
code.0x80070003 = ERROR_PATH_NOT_FOUND – the system cannot find the path specified.
code.0x80070005 = E_ACCESSDENIED – access is denied.
code.0x80070008 = ERROR_NOT_ENOUGH_MEMORY – not enough memory to process this command.
code.0x8007000E = E_OUTOFMEMORY – out of memory.
code.0x80070020 = ERROR_SHARING_VIOLATION – the file is being used by another process.
code.0x80070057 = E_INVALIDARG – the parameter is incorrect.
code.0x80070070 = ERROR_DISK_FULL – there is not enough space on the disk.
code.0x800700B7 = ERROR_ALREADY_EXISTS – the file already exists.
code.0x80070422 = ERROR_SERVICE_DISABLED – the service is disabled and cannot be started.
code.0x8007045B = ERROR_SHUTDOWN_IN_PROGRESS – a system shutdown is in progress.
code.0x80070490 = ERROR_NOT_FOUND – element not found.
code.0x800705B4 = ERROR_TIMEOUT – the operation timed out.
code.0x800706BA = RPC_S_SERVER_UNAVAILABLE – the RPC server is unavailable.
code.0x80070641 = MSI 1601 – the Windows Installer service could not be accessed.
code.0x80070642 = MSI 1602 – the installation was cancelled by the user.
code.0x80070643 = MSI 1603 – fatal error during installation (look for "Return value 3" in the MSI log).
code.0x80070645 = MSI 1605 – this action is only valid for products that are currently installed.
code.0x80070652 = MSI 1618 – another installation is already in progress; finish it first.
code.0x80070653 = MSI 1619 – the installation package could not be opened (missing or not accessible).
code.0x80070654 = MSI 1620 – the installation package could not be opened; it is not a valid Windows Installer package.
code.0x80070659 = MSI 1625 – the installation is forbidden by system policy.
code.0x80070661 = MSI 1633 – the package is not supported by this processor platform.
code.0x80070666 = MSI 1638 – another version of this product is already installed.
code.0x80070669 = MSI 1641 – the installer has initiated a restart to complete the installation.
code.0x80070BC2 = 3010 – success, a restart is required to complete the operation.
code.0x80070BC9 = 3017 – the operation failed, a restart is required to roll back the changes.
code.0x80072EE2 = 12002 – the request timed out (WinINet/WinHTTP).
code.0x80072EE7 = 12007 – the server name could not be resolved (DNS).
code.0x80072EFD = 12029 – a connection to the server could not be established.
code.0x80072F8F = 12175 – secure channel error (TLS / certificate).
code.0x80240017 = WU_E_NOT_APPLICABLE – no applicable updates.
code.0x8024001E = WU_E_SERVICE_STOP – the operation did not complete because the service or system was being shut down.
code.0x80240022 = WU_E_ALL_UPDATES_FAILED – the operation failed for all the updates.
code.0x80240438 = WU_E_PT_ENDPOINT_UNREACHABLE – there is no network connection to the update server.
code.0x8024200D = WU_E_UH_NEEDANOTHERDOWNLOAD – the update needs to download more content.
code.0x80244019 = WU_E_PT_HTTP_STATUS_NOT_FOUND – HTTP 404, the file was not found on the server.
code.0x8024401C = WU_E_PT_HTTP_STATUS_REQUEST_TIMEOUT – HTTP 408, the request timed out.
code.0x80244022 = WU_E_PT_HTTP_STATUS_SERVICE_UNAVAIL – HTTP 503, the service is unavailable.
code.0x8024402C = WU_E_PT_WINHTTP_NAME_NOT_RESOLVED – the proxy or server name could not be resolved.
code.0x87D00314 = ConfigMgr – CI Version Info timed out (policy or content not available yet).
code.0x87D00324 = ConfigMgr – the application was not detected after installation completed (check the detection method).
code.0x87D00325 = ConfigMgr – the application was still detected after uninstall completed.
code.0x87D00607 = ConfigMgr – content not found (no distribution point with the content).
code.0x87D00664 = ConfigMgr – the updates handler job was cancelled.
code.0x87D00668 = ConfigMgr – the software update is still detected as actionable after apply.
code.0x87D00692 = ConfigMgr – group policy conflict (WSUS server setting).
code.0x87D01106 = ConfigMgr – failed to verify the executable file is valid or to construct the command line.

# --- HTTP status codes (#28) ---
# Key = "http." + status ("http.404"), "http." + status + "." + IIS substatus ("http.404.3"),
# class fallback for codes without an own description ("http.4xx"). You can add your own codes.
http.short = HTTP {code} {status}
http.short.sub = HTTP {code} {status} IIS substatus: {substatus}
http.unknown = Unknown HTTP status
http.1xx = 1xx – informational response
http.2xx = 2xx – success
http.3xx = 3xx – redirection
http.4xx = 4xx – client error
http.5xx = 5xx – server error
http.100 = Continue – the client may continue sending the request body.
http.101 = Switching Protocols – the server switches the protocol (e.g. to WebSocket).
http.200 = OK – the request succeeded.
http.201 = Created – the request succeeded and a new resource was created.
http.202 = Accepted – the request was accepted, its processing is not finished yet.
http.204 = No Content – the request succeeded, the response has no content.
http.206 = Partial Content – only a part of the resource is sent (range request).
http.207 = Multi-Status – WebDAV: several status values for several resources.
http.301 = Moved Permanently – the resource has a new permanent URL.
http.302 = Found – the resource is temporarily at another URL (redirect; IIS: "Object moved").
http.303 = See Other – the response is at another URL, to be fetched with GET.
http.304 = Not Modified – the client's cached copy is still valid.
http.307 = Temporary Redirect – temporary redirect; the method and body stay the same.
http.308 = Permanent Redirect – permanent redirect; the method and body stay the same.
http.400 = Bad Request – the request is malformed (syntax, header, URL).
http.401 = Unauthorized – authentication is required or has failed (IIS: access denied).
http.403 = Forbidden – the server refuses the request (missing permission or a forbidding setting).
http.404 = Not Found – the server has no resource at this URL (IIS: also requests blocked by request filtering).
http.405 = Method Not Allowed – the HTTP method (verb) is not allowed for this resource.
http.406 = Not Acceptable – the server cannot return the content in a format the client accepts.
http.407 = Proxy Authentication Required – the client must authenticate at the proxy.
http.408 = Request Timeout – the client did not send the whole request in time.
http.409 = Conflict – the request conflicts with the current state of the resource.
http.410 = Gone – the resource was removed permanently.
http.411 = Length Required – the request has no Content-Length header.
http.412 = Precondition Failed – a precondition in the request headers is not met.
http.413 = Content Too Large – the request body is larger than the server allows.
http.414 = URI Too Long – the URL is longer than the server allows.
http.415 = Unsupported Media Type – the format of the request body is not supported.
http.416 = Range Not Satisfiable – the requested byte range is outside the resource.
http.417 = Expectation Failed – the Expect request header cannot be met.
http.421 = Misdirected Request – the request was sent to a server that cannot answer it.
http.422 = Unprocessable Content – the request is well-formed but its content cannot be processed.
http.423 = Locked – WebDAV: the resource is locked.
http.426 = Upgrade Required – the client must switch to another protocol (e.g. TLS).
http.429 = Too Many Requests – the client sent too many requests in a short time (rate limit).
http.431 = Request Header Fields Too Large – the request headers are too large.
http.451 = Unavailable For Legal Reasons – access is blocked for legal reasons.
http.500 = Internal Server Error – an error occurred on the server while processing the request.
http.501 = Not Implemented – the server does not support the requested function.
http.502 = Bad Gateway – the server, acting as a gateway or proxy, got an invalid response from the upstream server.
http.503 = Service Unavailable – the server cannot handle the request now (overloaded, application pool stopped).
http.504 = Gateway Timeout – the server, acting as a gateway or proxy, got no response from the upstream server in time.
http.505 = HTTP Version Not Supported – the HTTP version of the request is not supported.
http.400.1 = Invalid Destination header (WebDAV).
http.400.2 = Invalid Depth header (WebDAV).
http.400.3 = Invalid If header (WebDAV).
http.400.4 = Invalid Overwrite header (WebDAV).
http.400.5 = Invalid Translate header (WebDAV).
http.400.6 = Invalid request body.
http.400.7 = Invalid Content-Length.
http.400.8 = Invalid timeout.
http.400.9 = Invalid lock token.
http.400.10 = Invalid X-Forwarded-For (XFF) header.
http.400.11 = Invalid WebSocket request.
http.401.1 = Logon failed (wrong user name or password).
http.401.2 = Logon failed due to server configuration (no authentication method in common with the client).
http.401.3 = Unauthorized due to the ACL on the resource (NTFS permissions).
http.401.4 = Authorization failed by a filter.
http.401.5 = Authorization failed by an ISAPI/CGI application.
http.401.501 = Access denied: too many concurrent requests from the same client IP (Dynamic IP Restrictions).
http.401.502 = Access denied: too many requests from the same client IP in a time period (Dynamic IP Restrictions).
http.401.503 = Access denied: the IP address is in the deny list (IP and Domain Restrictions).
http.401.504 = Access denied: the host name is in the deny list (IP and Domain Restrictions).
