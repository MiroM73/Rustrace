# --- Fehlercodes ---
code.success = Erfolg (S_OK / ERROR_SUCCESS).
code.unknown = Unbekannter Code ({facility})
code.source.description = Beschreibung
code.source.windows = Windows
code.0x80004001 = E_NOTIMPL – nicht implementiert.
code.0x80004002 = E_NOINTERFACE – Schnittstelle wird nicht unterstützt.
code.0x80004004 = E_ABORT – Vorgang abgebrochen.
code.0x80004005 = E_FAIL – unbekannter Fehler.
code.0x8000FFFF = E_UNEXPECTED – unerwarteter Fehler.
code.0x80041001 = WBEM_E_FAILED – allgemeiner WMI-Fehler.
code.0x80041002 = WBEM_E_NOT_FOUND – WMI-Objekt nicht gefunden.
code.0x80041010 = WBEM_E_INVALID_CLASS – ungültige WMI-Klasse (oft beschädigtes WMI / fehlende Client-Klasse).
code.0x80070002 = ERROR_FILE_NOT_FOUND – das System kann die angegebene Datei nicht finden.
code.0x80070003 = ERROR_PATH_NOT_FOUND – das System kann den angegebenen Pfad nicht finden.
code.0x80070005 = E_ACCESSDENIED – Zugriff verweigert.
code.0x80070008 = ERROR_NOT_ENOUGH_MEMORY – nicht genügend Speicher, um den Befehl auszuführen.
code.0x8007000E = E_OUTOFMEMORY – nicht genügend Speicher.
code.0x80070020 = ERROR_SHARING_VIOLATION – die Datei wird von einem anderen Prozess verwendet.
code.0x80070057 = E_INVALIDARG – falscher Parameter.
code.0x80070070 = ERROR_DISK_FULL – nicht genügend Speicherplatz auf dem Datenträger.
code.0x800700B7 = ERROR_ALREADY_EXISTS – die Datei existiert bereits.
code.0x80070422 = ERROR_SERVICE_DISABLED – der Dienst ist deaktiviert und kann nicht gestartet werden.
code.0x8007045B = ERROR_SHUTDOWN_IN_PROGRESS – das System wird heruntergefahren.
code.0x80070490 = ERROR_NOT_FOUND – Element nicht gefunden.
code.0x800705B4 = ERROR_TIMEOUT – Zeitüberschreitung beim Vorgang.
code.0x800706BA = RPC_S_SERVER_UNAVAILABLE – der RPC-Server ist nicht verfügbar.
code.0x80070641 = MSI 1601 – auf den Windows Installer-Dienst konnte nicht zugegriffen werden.
code.0x80070642 = MSI 1602 – die Installation wurde vom Benutzer abgebrochen.
code.0x80070643 = MSI 1603 – schwerwiegender Fehler bei der Installation (Details im MSI-Log: „Return value 3“).
code.0x80070645 = MSI 1605 – die Aktion ist nur für installierte Produkte gültig.
code.0x80070652 = MSI 1618 – eine andere Installation läuft bereits; zuerst abschließen.
code.0x80070653 = MSI 1619 – das Installationspaket kann nicht geöffnet werden (fehlt oder nicht zugänglich).
code.0x80070654 = MSI 1620 – das Installationspaket kann nicht geöffnet werden; es ist kein gültiges Windows Installer-Paket.
code.0x80070659 = MSI 1625 – die Installation ist durch eine Systemrichtlinie verboten.
code.0x80070661 = MSI 1633 – das Paket wird auf dieser Prozessorplattform nicht unterstützt.
code.0x80070666 = MSI 1638 – eine andere Version des Produkts ist bereits installiert.
code.0x80070669 = MSI 1641 – der Installer hat einen Neustart eingeleitet, um die Installation abzuschließen.
code.0x80070BC2 = 3010 – erfolgreich, zum Abschluss ist ein Neustart erforderlich.
code.0x80070BC9 = 3017 – der Vorgang ist fehlgeschlagen, zum Rückgängigmachen ist ein Neustart erforderlich.
code.0x80072EE2 = 12002 – Zeitüberschreitung der Anforderung (WinINet/WinHTTP).
code.0x80072EE7 = 12007 – der Servername konnte nicht aufgelöst werden (DNS).
code.0x80072EFD = 12029 – es konnte keine Verbindung zum Server hergestellt werden.
code.0x80072F8F = 12175 – Fehler im sicheren Kanal (TLS / Zertifikat).
code.0x80240017 = WU_E_NOT_APPLICABLE – keine anwendbaren Updates.
code.0x8024001E = WU_E_SERVICE_STOP – Vorgang nicht abgeschlossen, Dienst oder System wird heruntergefahren.
code.0x80240022 = WU_E_ALL_UPDATES_FAILED – der Vorgang ist für alle Updates fehlgeschlagen.
code.0x80240438 = WU_E_PT_ENDPOINT_UNREACHABLE – keine Netzwerkverbindung zum Updateserver.
code.0x8024200D = WU_E_UH_NEEDANOTHERDOWNLOAD – das Update muss weitere Inhalte herunterladen.
code.0x80244019 = WU_E_PT_HTTP_STATUS_NOT_FOUND – HTTP 404, die Datei wurde auf dem Server nicht gefunden.
code.0x8024401C = WU_E_PT_HTTP_STATUS_REQUEST_TIMEOUT – HTTP 408, Zeitüberschreitung der Anforderung.
code.0x80244022 = WU_E_PT_HTTP_STATUS_SERVICE_UNAVAIL – HTTP 503, der Dienst ist nicht verfügbar.
code.0x8024402C = WU_E_PT_WINHTTP_NAME_NOT_RESOLVED – der Proxy- oder Servername konnte nicht aufgelöst werden.
code.0x87D00314 = ConfigMgr – Zeitüberschreitung bei CI Version Info (Richtlinie oder Inhalt noch nicht verfügbar).
code.0x87D00324 = ConfigMgr – die Anwendung wurde nach Abschluss der Installation nicht erkannt (Erkennungsmethode prüfen).
code.0x87D00325 = ConfigMgr – die Anwendung wurde nach der Deinstallation weiterhin erkannt.
code.0x87D00607 = ConfigMgr – Inhalt nicht gefunden (kein Verteilungspunkt mit dem Inhalt).
code.0x87D00664 = ConfigMgr – der Auftrag des Update-Handlers wurde abgebrochen.
code.0x87D00668 = ConfigMgr – das Softwareupdate wird nach der Anwendung weiterhin als erforderlich erkannt.
code.0x87D00692 = ConfigMgr – Gruppenrichtlinienkonflikt (WSUS-Servereinstellung).
code.0x87D01106 = ConfigMgr – die ausführbare Datei konnte nicht überprüft oder die Befehlszeile nicht erstellt werden.
