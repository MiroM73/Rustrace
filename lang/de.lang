# --- HTTP-Statuscodes (#28) ---
http.short = HTTP {code} {status}
http.short.sub = HTTP {code} {status} IIS-Unterstatus: {substatus}
http.unknown = Unbekannter HTTP-Status
http.1xx = 1xx – Informationsantwort
http.2xx = 2xx – Erfolg
http.3xx = 3xx – Umleitung
http.4xx = 4xx – Clientfehler
http.5xx = 5xx – Serverfehler
http.100 = Continue – der Client kann den Anforderungstext weiter senden.
http.101 = Switching Protocols – der Server wechselt das Protokoll (z. B. zu WebSocket).
http.200 = OK – die Anforderung war erfolgreich.
http.201 = Created – die Anforderung war erfolgreich, eine neue Ressource wurde erstellt.
http.202 = Accepted – die Anforderung wurde angenommen, ihre Verarbeitung ist noch nicht abgeschlossen.
http.204 = No Content – die Anforderung war erfolgreich, die Antwort hat keinen Inhalt.
http.206 = Partial Content – nur ein Teil der Ressource wird gesendet (Bereichsanforderung).
http.207 = Multi-Status – WebDAV: mehrere Statuswerte für mehrere Ressourcen.
http.301 = Moved Permanently – die Ressource hat eine neue dauerhafte URL.
http.302 = Found – die Ressource liegt vorübergehend unter einer anderen URL (Umleitung; IIS: "Object moved").
http.303 = See Other – die Antwort liegt unter einer anderen URL und ist mit GET abzurufen.
http.304 = Not Modified – die zwischengespeicherte Kopie des Clients ist noch gültig.
http.307 = Temporary Redirect – vorübergehende Umleitung; Methode und Inhalt bleiben gleich.
http.308 = Permanent Redirect – dauerhafte Umleitung; Methode und Inhalt bleiben gleich.
http.400 = Bad Request – die Anforderung ist fehlerhaft (Syntax, Header, URL).
http.401 = Unauthorized – Authentifizierung ist erforderlich oder fehlgeschlagen (IIS: Zugriff verweigert).
http.403 = Forbidden – der Server verweigert die Anforderung (fehlende Berechtigung oder eine verbietende Einstellung).
http.404 = Not Found – der Server hat unter dieser URL keine Ressource (IIS: auch von der Anforderungsfilterung blockierte Anforderungen).
http.405 = Method Not Allowed – die HTTP-Methode (Verb) ist für diese Ressource nicht zulässig.
http.406 = Not Acceptable – der Server kann den Inhalt nicht in einem vom Client akzeptierten Format liefern.
http.407 = Proxy Authentication Required – der Client muss sich am Proxy authentifizieren.
http.408 = Request Timeout – der Client hat die Anforderung nicht rechtzeitig vollständig gesendet.
http.409 = Conflict – die Anforderung steht im Konflikt mit dem aktuellen Zustand der Ressource.
http.410 = Gone – die Ressource wurde dauerhaft entfernt.
http.411 = Length Required – der Anforderung fehlt der Header Content-Length.
http.412 = Precondition Failed – eine Vorbedingung in den Anforderungsheadern ist nicht erfüllt.
http.413 = Content Too Large – der Anforderungstext ist größer als vom Server erlaubt.
http.414 = URI Too Long – die URL ist länger als vom Server erlaubt.
http.415 = Unsupported Media Type – das Format des Anforderungstexts wird nicht unterstützt.
http.416 = Range Not Satisfiable – der angeforderte Bytebereich liegt außerhalb der Ressource.
http.417 = Expectation Failed – der Expect-Header kann nicht erfüllt werden.
http.421 = Misdirected Request – die Anforderung ging an einen Server, der sie nicht beantworten kann.
http.422 = Unprocessable Content – die Anforderung ist korrekt aufgebaut, ihr Inhalt kann aber nicht verarbeitet werden.
http.423 = Locked – WebDAV: die Ressource ist gesperrt.
http.426 = Upgrade Required – der Client muss zu einem anderen Protokoll wechseln (z. B. TLS).
http.429 = Too Many Requests – der Client hat in kurzer Zeit zu viele Anforderungen gesendet (Ratenbegrenzung).
http.431 = Request Header Fields Too Large – die Anforderungsheader sind zu groß.
http.451 = Unavailable For Legal Reasons – der Zugriff ist aus rechtlichen Gründen gesperrt.
http.500 = Internal Server Error – bei der Verarbeitung der Anforderung ist auf dem Server ein Fehler aufgetreten.
http.501 = Not Implemented – der Server unterstützt die angeforderte Funktion nicht.
http.502 = Bad Gateway – der Server hat als Gateway oder Proxy eine ungültige Antwort vom Upstream-Server erhalten.
http.503 = Service Unavailable – der Server kann die Anforderung derzeit nicht verarbeiten (überlastet, Anwendungspool beendet).
http.504 = Gateway Timeout – der Server hat als Gateway oder Proxy nicht rechtzeitig eine Antwort vom Upstream-Server erhalten.
http.505 = HTTP Version Not Supported – die HTTP-Version der Anforderung wird nicht unterstützt.
http.400.1 = Ungültiger Destination-Header (WebDAV).
http.400.2 = Ungültiger Depth-Header (WebDAV).
http.400.3 = Ungültiger If-Header (WebDAV).
http.400.4 = Ungültiger Overwrite-Header (WebDAV).
http.400.5 = Ungültiger Translate-Header (WebDAV).
http.400.6 = Ungültiger Anforderungstext.
http.400.7 = Ungültige Content-Length.
http.400.8 = Ungültiges Zeitlimit.
http.400.9 = Ungültiges Sperrtoken.
http.400.10 = Ungültiger X-Forwarded-For-Header (XFF).
http.400.11 = Ungültige WebSocket-Anforderung.
http.401.1 = Anmeldung fehlgeschlagen (falscher Benutzername oder falsches Kennwort).
http.401.2 = Anmeldung aufgrund der Serverkonfiguration fehlgeschlagen (keine gemeinsame Authentifizierungsmethode mit dem Client).
http.401.3 = Nicht autorisiert aufgrund der ACL der Ressource (NTFS-Berechtigungen).
http.401.4 = Autorisierung durch einen Filter abgelehnt.
http.401.5 = Autorisierung durch eine ISAPI-/CGI-Anwendung abgelehnt.
http.401.501 = Zugriff verweigert: zu viele gleichzeitige Anforderungen von derselben Client-IP (Dynamic IP Restrictions).
http.401.502 = Zugriff verweigert: zu viele Anforderungen von derselben Client-IP in einem Zeitraum (Dynamic IP Restrictions).
http.401.503 = Zugriff verweigert: die IP-Adresse steht in der Sperrliste (IP and Domain Restrictions).
http.401.504 = Zugriff verweigert: der Hostname steht in der Sperrliste (IP and Domain Restrictions).
http.403.1 = Ausführungszugriff verweigert.
http.403.2 = Lesezugriff verweigert.
