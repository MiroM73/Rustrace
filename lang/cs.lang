# --- Chybové kódy ---
code.success = Úspěch (S_OK / ERROR_SUCCESS).
code.unknown = Neznámý kód ({facility})
code.source.description = Popis
code.source.windows = Windows
code.0x80004001 = E_NOTIMPL – funkce není implementována.
code.0x80004002 = E_NOINTERFACE – rozhraní není podporováno.
code.0x80004004 = E_ABORT – operace byla přerušena.
code.0x80004005 = E_FAIL – nespecifikovaná chyba.
code.0x8000FFFF = E_UNEXPECTED – neočekávaná chyba.
code.0x80041001 = WBEM_E_FAILED – obecná chyba WMI.
code.0x80041002 = WBEM_E_NOT_FOUND – objekt WMI nebyl nalezen.
code.0x80041010 = WBEM_E_INVALID_CLASS – neplatná třída WMI (často poškozené WMI / chybějící třída klienta).
code.0x80070002 = ERROR_FILE_NOT_FOUND – systém nemůže nalézt uvedený soubor.
code.0x80070003 = ERROR_PATH_NOT_FOUND – systém nemůže nalézt uvedenou cestu.
code.0x80070005 = E_ACCESSDENIED – přístup byl odepřen.
code.0x80070008 = ERROR_NOT_ENOUGH_MEMORY – nedostatek paměti pro zpracování příkazu.
code.0x8007000E = E_OUTOFMEMORY – nedostatek paměti.
code.0x80070020 = ERROR_SHARING_VIOLATION – soubor používá jiný proces.
code.0x80070057 = E_INVALIDARG – parametr je nesprávný.
code.0x80070070 = ERROR_DISK_FULL – na disku není dostatek místa.
code.0x800700B7 = ERROR_ALREADY_EXISTS – soubor již existuje.
code.0x80070422 = ERROR_SERVICE_DISABLED – služba je zakázána a nelze ji spustit.
code.0x8007045B = ERROR_SHUTDOWN_IN_PROGRESS – probíhá vypínání systému.
code.0x80070490 = ERROR_NOT_FOUND – prvek nebyl nalezen.
code.0x800705B4 = ERROR_TIMEOUT – operace skončila vypršením časového limitu.
code.0x800706BA = RPC_S_SERVER_UNAVAILABLE – server RPC není k dispozici.
code.0x80070641 = MSI 1601 – nelze získat přístup ke službě Windows Installer.
code.0x80070642 = MSI 1602 – instalaci zrušil uživatel.
code.0x80070643 = MSI 1603 – závažná chyba během instalace (podrobnosti hledejte v MSI logu: „Return value 3“).
code.0x80070645 = MSI 1605 – akce je platná jen pro nainstalované produkty.
code.0x80070652 = MSI 1618 – probíhá jiná instalace, nejprve ji dokončete.
code.0x80070653 = MSI 1619 – instalační balíček nelze otevřít (chybí nebo není přístupný).
code.0x80070654 = MSI 1620 – instalační balíček nelze otevřít, není to platný balíček Windows Installer.
code.0x80070659 = MSI 1625 – instalace je zakázána systémovou zásadou.
code.0x80070661 = MSI 1633 – balíček není podporován na této platformě procesoru.
code.0x80070666 = MSI 1638 – jiná verze produktu je již nainstalována.
code.0x80070669 = MSI 1641 – instalátor spustil restart k dokončení instalace.
code.0x80070BC2 = 3010 – úspěch, k dokončení je nutný restart.
code.0x80070BC9 = 3017 – operace selhala, k vrácení změn je nutný restart.
code.0x80072EE2 = 12002 – vypršel časový limit požadavku (WinINet/WinHTTP).
code.0x80072EE7 = 12007 – název serveru nelze přeložit (DNS).
code.0x80072EFD = 12029 – nelze se připojit k serveru.
code.0x80072F8F = 12175 – chyba zabezpečeného kanálu (TLS / certifikát).
code.0x80240017 = WU_E_NOT_APPLICABLE – žádné použitelné aktualizace.
code.0x8024001E = WU_E_SERVICE_STOP – operace nedokončena, služba nebo systém se vypíná.
code.0x80240022 = WU_E_ALL_UPDATES_FAILED – operace selhala pro všechny aktualizace.
code.0x80240438 = WU_E_PT_ENDPOINT_UNREACHABLE – k serveru aktualizací není síťové připojení.
code.0x8024200D = WU_E_UH_NEEDANOTHERDOWNLOAD – aktualizace potřebuje stáhnout další obsah.
code.0x80244019 = WU_E_PT_HTTP_STATUS_NOT_FOUND – HTTP 404, soubor nebyl na serveru nalezen.
code.0x8024401C = WU_E_PT_HTTP_STATUS_REQUEST_TIMEOUT – HTTP 408, vypršel časový limit.
code.0x80244022 = WU_E_PT_HTTP_STATUS_SERVICE_UNAVAIL – HTTP 503, služba není dostupná.
code.0x8024402C = WU_E_PT_WINHTTP_NAME_NOT_RESOLVED – název proxy nebo serveru nelze přeložit.
code.0x87D00314 = ConfigMgr – vypršel časový limit CI Version Info (zásada nebo obsah ještě nejsou k dispozici).
code.0x87D00324 = ConfigMgr – aplikace nebyla po dokončení instalace detekována (zkontrolujte metodu detekce).
code.0x87D00325 = ConfigMgr – aplikace byla po odinstalaci stále detekována.
code.0x87D00607 = ConfigMgr – obsah nebyl nalezen (žádný distribuční bod s obsahem).
code.0x87D00664 = ConfigMgr – úloha obsluhy aktualizací byla zrušena.
code.0x87D00668 = ConfigMgr – aktualizace je po použití stále detekována jako potřebná.
code.0x87D00692 = ConfigMgr – konflikt zásad skupiny (nastavení serveru WSUS).
code.0x87D01106 = ConfigMgr – nepodařilo se ověřit spustitelný soubor nebo sestavit příkazový řádek.
