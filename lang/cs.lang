code.0x80070020 = ERROR_SHARING_VIOLATION – soubor používá jiný proces.
code.0x80070057 = E_INVALIDARG – parametr je nesprávný.
code.0x80070070 = ERROR_DISK_FULL – na disku není dostatek místa.
code.0x800700B7 = ERROR_ALREADY_EXISTS – soubor již existuje.
code.0x80070422 = ERROR_SERVICE_DISABLED – služba je zakázána a nelze ji spustit.
code.0x8007045B = ERROR_SHUTDOWN_IN_PROGRESS – probíhá vypínání systému.
code.0x80070490 = ERROR_NOT_FOUND – prvek nebyl nalezen.
code.0x800705B4 = ERROR_TIMEOUT – operace skončila vypršením časového limitu.
code.0x800706BA = RPC_S_SERVER_UNAVAILABLE – server RPC není k dispozici.
code.0x80070641 = MSI 1601 – nelze získat přístup ke službě Windows Installer.
code.0x80070642 = MSI 1602 – instalaci zrušil uživatel.
code.0x80070643 = MSI 1603 – závažná chyba během instalace (podrobnosti hledejte v MSI logu: „Return value 3“).
code.0x80070645 = MSI 1605 – akce je platná jen pro nainstalované produkty.
code.0x80070652 = MSI 1618 – probíhá jiná instalace, nejprve ji dokončete.
code.0x80070653 = MSI 1619 – instalační balíček nelze otevřít (chybí nebo není přístupný).
code.0x80070654 = MSI 1620 – instalační balíček nelze otevřít, není to platný balíček Windows Installer.
code.0x80070659 = MSI 1625 – instalace je zakázána systémovou zásadou.
code.0x80070661 = MSI 1633 – balíček není podporován na této platformě procesoru.
code.0x80070666 = MSI 1638 – jiná verze produktu je již nainstalována.
