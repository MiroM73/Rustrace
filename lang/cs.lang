code.0x80240438 = WU_E_PT_ENDPOINT_UNREACHABLE – k serveru aktualizací není síťové připojení.
code.0x8024200D = WU_E_UH_NEEDANOTHERDOWNLOAD – aktualizace potřebuje stáhnout další obsah.
code.0x80244019 = WU_E_PT_HTTP_STATUS_NOT_FOUND – HTTP 404, soubor nebyl na serveru nalezen.
code.0x8024401C = WU_E_PT_HTTP_STATUS_REQUEST_TIMEOUT – HTTP 408, vypršel časový limit.
code.0x80244022 = WU_E_PT_HTTP_STATUS_SERVICE_UNAVAIL – HTTP 503, služba není dostupná.
code.0x8024402C = WU_E_PT_WINHTTP_NAME_NOT_RESOLVED – název proxy nebo serveru nelze přeložit.
code.0x87D00314 = ConfigMgr – vypršel časový limit CI Version Info (zásada nebo obsah ještě nejsou k dispozici).
code.0x87D00324 = ConfigMgr – aplikace nebyla po dokončení instalace detekována (zkontrolujte metodu detekce).
code.0x87D00325 = ConfigMgr – aplikace byla po odinstalaci stále detekována.
code.0x87D00607 = ConfigMgr – obsah nebyl nalezen (žádný distribuční bod s obsahem).
code.0x87D00664 = ConfigMgr – úloha obsluhy aktualizací byla zrušena.
code.0x87D00668 = ConfigMgr – aktualizace je po použití stále detekována jako potřebná.
code.0x87D00692 = ConfigMgr – konflikt zásad skupiny (nastavení serveru WSUS).
code.0x87D01106 = ConfigMgr – nepodařilo se ověřit spustitelný soubor nebo sestavit příkazový řádek.

# --- Stavové kódy HTTP (#28) ---
http.short = HTTP {code} {status}
http.short.sub = HTTP {code} {status} IIS podstav: {substatus}
http.unknown = Neznámý stav HTTP
http.1xx = 1xx – informativní odpověď
http.2xx = 2xx – úspěch
http.3xx = 3xx – přesměrování
http.4xx = 4xx – chyba klienta
http.5xx = 5xx – chyba serveru
http.100 = Continue – klient může pokračovat v odesílání těla požadavku.
http.101 = Switching Protocols – server přepíná protokol (např. na WebSocket).
http.200 = OK – požadavek byl úspěšný.
http.201 = Created – požadavek byl úspěšný a byl vytvořen nový prostředek.
http.202 = Accepted – požadavek byl přijat, jeho zpracování ještě neskončilo.
http.204 = No Content – požadavek byl úspěšný, odpověď nemá obsah.
http.206 = Partial Content – posílá se jen část prostředku (požadavek na rozsah).
http.207 = Multi-Status – WebDAV: více stavů pro více prostředků.
http.301 = Moved Permanently – prostředek má novou trvalou URL.
http.302 = Found – prostředek je dočasně na jiné URL (přesměrování; IIS: "Object moved").
http.303 = See Other – odpověď je na jiné URL, je třeba ji načíst přes GET.
http.304 = Not Modified – kopie v mezipaměti klienta je stále platná.
http.307 = Temporary Redirect – dočasné přesměrování; metoda a tělo zůstávají.
http.308 = Permanent Redirect – trvalé přesměrování; metoda a tělo zůstávají.
http.400 = Bad Request – požadavek je chybný (syntaxe, hlavička, URL).
http.401 = Unauthorized – vyžaduje se ověření nebo ověření selhalo (IIS: přístup odepřen).
http.403 = Forbidden – server požadavek odmítá (chybějící oprávnění nebo zakazující nastavení).
http.404 = Not Found – server nemá na této URL žádný prostředek (IIS: i požadavky zablokované filtrováním).
http.405 = Method Not Allowed – metoda HTTP (sloveso) není pro tento prostředek povolena.
http.406 = Not Acceptable – server nedokáže vrátit obsah ve formátu, který klient přijímá.
http.407 = Proxy Authentication Required – klient se musí ověřit na proxy.
http.408 = Request Timeout – klient neodeslal celý požadavek včas.
http.409 = Conflict – požadavek je v rozporu s aktuálním stavem prostředku.
http.410 = Gone – prostředek byl trvale odstraněn.
http.411 = Length Required – požadavek nemá hlavičku Content-Length.
http.412 = Precondition Failed – podmínka v hlavičkách požadavku není splněna.
http.413 = Content Too Large – tělo požadavku je větší, než server povoluje.
http.414 = URI Too Long – URL je delší, než server povoluje.
http.415 = Unsupported Media Type – formát těla požadavku není podporován.
http.416 = Range Not Satisfiable – požadovaný rozsah bajtů je mimo prostředek.
http.417 = Expectation Failed – hlavičku Expect nelze splnit.
http.421 = Misdirected Request – požadavek byl odeslán serveru, který na něj nedokáže odpovědět.
http.422 = Unprocessable Content – požadavek je správně sestaven, ale jeho obsah nelze zpracovat.
http.423 = Locked – WebDAV: prostředek je zamčený.
http.426 = Upgrade Required – klient musí přejít na jiný protokol (např. TLS).
http.429 = Too Many Requests – klient odeslal příliš mnoho požadavků v krátké době (omezení počtu).
http.431 = Request Header Fields Too Large – hlavičky požadavku jsou příliš velké.
http.451 = Unavailable For Legal Reasons – přístup je zablokován z právních důvodů.
http.500 = Internal Server Error – při zpracování požadavku došlo k chybě na serveru.
http.501 = Not Implemented – server nepodporuje požadovanou funkci.
http.502 = Bad Gateway – server jako brána nebo proxy obdržel neplatnou odpověď od dalšího serveru.
http.503 = Service Unavailable – server teď nemůže požadavek zpracovat (přetížení, zastavený fond aplikací).
http.504 = Gateway Timeout – server jako brána nebo proxy neobdržel včas odpověď od dalšího serveru.
http.505 = HTTP Version Not Supported – verze HTTP požadavku není podporována.
http.400.1 = Neplatná hlavička Destination (WebDAV).
http.400.2 = Neplatná hlavička Depth (WebDAV).
http.400.3 = Neplatná hlavička If (WebDAV).
http.400.4 = Neplatná hlavička Overwrite (WebDAV).
http.400.5 = Neplatná hlavička Translate (WebDAV).
http.400.6 = Neplatné tělo požadavku.
http.400.7 = Neplatná hodnota Content-Length.
http.400.8 = Neplatný časový limit.
http.400.9 = Neplatný token zámku.
http.400.10 = Neplatná hlavička X-Forwarded-For (XFF).
http.400.11 = Neplatný požadavek WebSocket.
http.401.1 = Přihlášení selhalo (nesprávné jméno nebo heslo).
http.401.2 = Přihlášení selhalo kvůli konfiguraci serveru (žádná společná metoda ověření s klientem).
http.401.3 = Neoprávněno kvůli ACL na prostředku (oprávnění NTFS).
http.401.4 = Autorizaci zamítl filtr.
http.401.5 = Autorizaci zamítla aplikace ISAPI/CGI.
http.401.501 = Přístup odepřen: příliš mnoho souběžných požadavků ze stejné IP klienta (Dynamic IP Restrictions).
http.401.502 = Přístup odepřen: příliš mnoho požadavků ze stejné IP klienta za určitou dobu (Dynamic IP Restrictions).
http.401.503 = Přístup odepřen: IP adresa je v seznamu zakázaných (IP and Domain Restrictions).
http.401.504 = Přístup odepřen: název hostitele je v seznamu zakázaných (IP and Domain Restrictions).
