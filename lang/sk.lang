code.0x80041010 = WBEM_E_INVALID_CLASS – neplatná trieda WMI (často poškodené WMI / chýbajúca trieda klienta).
code.0x80070002 = ERROR_FILE_NOT_FOUND – systém nemôže nájsť zadaný súbor.
code.0x80070003 = ERROR_PATH_NOT_FOUND – systém nemôže nájsť zadanú cestu.
code.0x80070005 = E_ACCESSDENIED – prístup bol odmietnutý.
code.0x80070008 = ERROR_NOT_ENOUGH_MEMORY – nedostatok pamäte na spracovanie príkazu.
code.0x8007000E = E_OUTOFMEMORY – nedostatok pamäte.
code.0x80070020 = ERROR_SHARING_VIOLATION – súbor používa iný proces.
code.0x80070057 = E_INVALIDARG – parameter je nesprávny.
code.0x80070070 = ERROR_DISK_FULL – na disku nie je dostatok miesta.
code.0x800700B7 = ERROR_ALREADY_EXISTS – súbor už existuje.
code.0x80070422 = ERROR_SERVICE_DISABLED – služba je zakázaná, nedá sa spustiť.
code.0x8007045B = ERROR_SHUTDOWN_IN_PROGRESS – prebieha vypínanie systému.
code.0x80070490 = ERROR_NOT_FOUND – prvok sa nenašiel.
code.0x800705B4 = ERROR_TIMEOUT – operácia skončila vypršaním časového limitu.
code.0x800706BA = RPC_S_SERVER_UNAVAILABLE – server RPC nie je k dispozícii.
code.0x80070641 = MSI 1601 – nedá sa pristúpiť k službe Windows Installer.
code.0x80070642 = MSI 1602 – inštaláciu zrušil používateľ.
code.0x80070643 = MSI 1603 – závažná chyba počas inštalácie (detail hľadaj v MSI logu: „Return value 3“).
code.0x80070645 = MSI 1605 – akcia je platná len pre nainštalované produkty.
code.0x80070652 = MSI 1618 – prebieha iná inštalácia, najprv ju treba dokončiť.
code.0x80070653 = MSI 1619 – inštalačný balík sa nedá otvoriť (chýba alebo nie je prístupný).
code.0x80070654 = MSI 1620 – inštalačný balík sa nedá otvoriť, nie je to platný balík Windows Installer.
code.0x80070659 = MSI 1625 – inštalácia je zakázaná systémovou politikou.
code.0x80070661 = MSI 1633 – balík nie je podporovaný na tejto platforme procesora.
code.0x80070666 = MSI 1638 – iná verzia produktu je už nainštalovaná.
code.0x80070669 = MSI 1641 – inštalátor spustil reštart na dokončenie inštalácie.
code.0x80070BC2 = 3010 – úspech, na dokončenie je potrebný reštart.
code.0x80070BC9 = 3017 – operácia zlyhala, na vrátenie zmien je potrebný reštart.
code.0x80072EE2 = 12002 – vypršal časový limit požiadavky (WinINet/WinHTTP).
code.0x80072EE7 = 12007 – názov servera sa nedá preložiť (DNS).
code.0x80072EFD = 12029 – nedá sa pripojiť na server.
code.0x80072F8F = 12175 – chyba zabezpečeného kanála (TLS / certifikát).
code.0x80240017 = WU_E_NOT_APPLICABLE – žiadne použiteľné aktualizácie.
code.0x8024001E = WU_E_SERVICE_STOP – operácia nedokončená, služba alebo systém sa vypína.
code.0x80240022 = WU_E_ALL_UPDATES_FAILED – operácia zlyhala pre všetky aktualizácie.
code.0x80240438 = WU_E_PT_ENDPOINT_UNREACHABLE – k serveru aktualizácií nie je sieťové spojenie.
code.0x8024200D = WU_E_UH_NEEDANOTHERDOWNLOAD – aktualizácia potrebuje stiahnuť ďalší obsah.
code.0x80244019 = WU_E_PT_HTTP_STATUS_NOT_FOUND – HTTP 404, súbor sa na serveri nenašiel.
code.0x8024401C = WU_E_PT_HTTP_STATUS_REQUEST_TIMEOUT – HTTP 408, vypršal časový limit.
code.0x80244022 = WU_E_PT_HTTP_STATUS_SERVICE_UNAVAIL – HTTP 503, služba nie je dostupná.
code.0x8024402C = WU_E_PT_WINHTTP_NAME_NOT_RESOLVED – názov proxy alebo servera sa nedá preložiť.
