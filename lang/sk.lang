# --- HTTP stavové kódy (#28) ---
http.short = HTTP {code} {status}
http.short.sub = HTTP {code} {status} IIS podstav: {substatus}
http.unknown = Neznámy HTTP stav
http.1xx = 1xx – informatívna odpoveď
http.2xx = 2xx – úspech
http.3xx = 3xx – presmerovanie
http.4xx = 4xx – chyba klienta
http.5xx = 5xx – chyba servera
http.100 = Continue – klient môže pokračovať v posielaní tela požiadavky.
http.101 = Switching Protocols – server prepína protokol (napr. na WebSocket).
http.200 = OK – požiadavka bola úspešná.
http.201 = Created – požiadavka bola úspešná a vytvoril sa nový zdroj.
http.202 = Accepted – požiadavka bola prijatá, jej spracovanie ešte neskončilo.
http.204 = No Content – požiadavka bola úspešná, odpoveď nemá obsah.
http.206 = Partial Content – posiela sa len časť zdroja (požiadavka na rozsah).
http.207 = Multi-Status – WebDAV: viac stavov pre viac zdrojov.
http.301 = Moved Permanently – zdroj má novú trvalú URL.
http.302 = Found – zdroj je dočasne na inej URL (presmerovanie; IIS: "Object moved").
http.303 = See Other – odpoveď je na inej URL, treba ju načítať cez GET.
http.304 = Not Modified – kópia v cache klienta je stále platná.
http.307 = Temporary Redirect – dočasné presmerovanie; metóda a telo zostávajú.
http.308 = Permanent Redirect – trvalé presmerovanie; metóda a telo zostávajú.
http.400 = Bad Request – požiadavka je chybná (syntax, hlavička, URL).
http.401 = Unauthorized – vyžaduje sa overenie alebo overenie zlyhalo (IIS: prístup odmietnutý).
http.403 = Forbidden – server požiadavku odmieta (chýbajúce oprávnenie alebo zakazujúce nastavenie).
http.404 = Not Found – server nemá na tejto URL žiadny zdroj (IIS: aj požiadavky zablokované filtrovaním).
http.405 = Method Not Allowed – HTTP metóda (sloveso) nie je pre tento zdroj povolená.
http.406 = Not Acceptable – server nevie vrátiť obsah vo formáte, ktorý klient prijíma.
http.407 = Proxy Authentication Required – klient sa musí overiť na proxy.
http.408 = Request Timeout – klient neposlal celú požiadavku včas.
http.409 = Conflict – požiadavka je v rozpore s aktuálnym stavom zdroja.
http.410 = Gone – zdroj bol natrvalo odstránený.
http.411 = Length Required – požiadavka nemá hlavičku Content-Length.
http.412 = Precondition Failed – podmienka v hlavičkách požiadavky nie je splnená.
http.413 = Content Too Large – telo požiadavky je väčšie, ako server povoľuje.
http.414 = URI Too Long – URL je dlhšia, ako server povoľuje.
http.415 = Unsupported Media Type – formát tela požiadavky nie je podporovaný.
http.416 = Range Not Satisfiable – požadovaný rozsah bajtov je mimo zdroja.
http.417 = Expectation Failed – hlavičku Expect nie je možné splniť.
http.421 = Misdirected Request – požiadavka bola poslaná serveru, ktorý na ňu nevie odpovedať.
http.422 = Unprocessable Content – požiadavka je správne zostavená, ale jej obsah nemožno spracovať.
http.423 = Locked – WebDAV: zdroj je zamknutý.
http.426 = Upgrade Required – klient musí prejsť na iný protokol (napr. TLS).
http.429 = Too Many Requests – klient poslal príliš veľa požiadaviek v krátkom čase (obmedzenie počtu).
http.431 = Request Header Fields Too Large – hlavičky požiadavky sú príliš veľké.
http.451 = Unavailable For Legal Reasons – prístup je zablokovaný z právnych dôvodov.
http.500 = Internal Server Error – pri spracovaní požiadavky nastala chyba na serveri.
http.501 = Not Implemented – server nepodporuje požadovanú funkciu.
http.502 = Bad Gateway – server ako brána alebo proxy dostal neplatnú odpoveď od ďalšieho servera.
http.503 = Service Unavailable – server teraz nemôže požiadavku spracovať (preťaženie, zastavený fond aplikácií).
http.504 = Gateway Timeout – server ako brána alebo proxy nedostal včas odpoveď od ďalšieho servera.
http.505 = HTTP Version Not Supported – verzia HTTP požiadavky nie je podporovaná.
